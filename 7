import tensorflow as tf
from tensorflow.keras import Sequential
from tensorflow.keras.layers import *
from tensorflow.keras.preprocessing.sequence import pad_sequences
from tensorflow.keras.preprocessing.text import Tokenizer

text=["deep learning is fun","machine learning is useful",
      "neural networks are powerful","deep learning is useful",
      "machine learning trains data","neural network learns patterns",
      "artificial intelligence is powerful","neural networks are revolutionary"]

t=Tokenizer()
t.fit_on_texts(text)
s=t.texts_to_sequences(text)

X=pad_sequences([v[:i] for v in s for i in range(1,len(v))]).astype("int32")
y=[v[i] for v in s for i in range(1,len(v))]
y=tf.constant(y,dtype=tf.int32)

n=len(t.word_index)+1
m=Sequential([Embedding(n,8),LSTM(16),Dense(n,activation='softmax')])
m.compile('adam','sparse_categorical_crossentropy',metrics=['accuracy'])
m.fit(X,y,epochs=300,verbose=0)

print("LSTM:",m.layers[1])
print("Accuracy:",m.evaluate(X,y,verbose=0)[1]*100)

for s in ["deep learning is","machine learning is","neural networks are"]:
    a=pad_sequences(t.texts_to_sequences([s]),maxlen=X.shape[1])
    print(s,"->",t.index_word[m.predict(a,verbose=0).argmax()])
