import tensorflow as tf
import matplotlib.pyplot as plt
from tensorflow.keras.applications import VGG16,ResNet50,vgg16,resnet50
from tensorflow.keras import layers as L,Model

(x,y),(xt,yt)=tf.keras.datasets.mnist.load_data()
acc,pr=[],[]

for net,pre in [(VGG16,vgg16.preprocess_input),(ResNet50,resnet50.preprocess_input)]:
    b=net(weights="imagenet",include_top=False)
    b.trainable=False
    i=L.Input((28,28,1))
    z=L.Resizing(224,224)(L.Lambda(tf.image.grayscale_to_rgb)(i))
    z=b(L.Lambda(pre)(z),training=False)
    o=L.Dense(10,activation="softmax")(L.GlobalAveragePooling2D()(z))
    m=Model(i,o)
    m.compile("adam","sparse_categorical_crossentropy",metrics=["accuracy"])
    m.fit(x[:3000],y[:3000],epochs=5,verbose=0)
    acc.append(m.evaluate(xt[:200],yt[:200],verbose=0)[1]*100)
    pr.append(m.predict(xt[:5],verbose=0).argmax(1))

plt.bar(["VGG16","ResNet50"],acc)
plt.ylabel("Accuracy (%)")
plt.show()

print("VGG16:",round(acc[0],2),"%")
print("ResNet50:",round(acc[1],2),"%")
