import matplotlib.pyplot as plt
import tensorflow as tf
from tensorflow.keras import Sequential
from tensorflow.keras.layers import *

g=Sequential([Input((100,)),Dense(784,activation="tanh"),Reshape((28,28,1))])
d=Sequential([Input((28,28,1)),Flatten(),Dense(1,activation="sigmoid")])
d.compile("adam","binary_crossentropy")
d.trainable=False
GAN=Sequential([g,d])
GAN.compile("adam","binary_crossentropy")

x=tf.keras.datasets.mnist.load_data()[0][0][:5000,...,None]/127.5-1

for _ in range(500):
    z=tf.random.normal((32,100))
    d.train_on_batch(x[tf.random.uniform((32,),0,5000,dtype=tf.int32)],tf.ones((32,1)))
    d.train_on_batch(g(z),tf.zeros((32,1)))
    GAN.train_on_batch(z,tf.ones((32,1)))

imgs=tf.concat([x[:5],g(tf.random.normal((5,100)))],0)

for i in range(10):
    plt.subplot(2,5,i+1)
    plt.imshow(imgs[i,:,:,0],cmap="gray")
    plt.title("real" if i<5 else "fake")
    plt.axis("off")
plt.show()
